# ── Required (set these before first use) ─────────────────────────────────────
REF_AUDIO_PATH=/absolute/path/to/reference.wav
REF_TEXT=Exact transcript of the reference audio
MODEL_SIZE=1.7B

# ── Recommended (most real deployments should set) ────────────────────────────
# QWEN3_TTS_IMAGE=ghcr.io/nmorgowicz-org/qwen3-tts-openvino:<sha>
# LOW_RAM_MODE=1

# ── Service ───────────────────────────────────────────────────────────────────
# QWEN3_TTS_PORT=8318            # Host port for the service
# TZ=UTC                         # Log timestamps
# FRONTEND_ENABLED=1             # Serve the web UI at / (0 for API-only)

# ── Memory limits ─────────────────────────────────────────────────────────────
# TTS_MEMORY_LIMIT=10G           # Serving container memory limit (raise if needed)
# TTS_MEMORY_SWAP_LIMIT=11G
# EXPORT_MEMORY_LIMIT=13G        # Export container limit (stop serving first on 15 GiB hosts)
# EXPORT_MEMORY_SWAP_LIMIT=14G

# ── Advanced (tune only if you have a reason) ─────────────────────────────────
# OV_INFERENCE_THREADS=6         # CPU threads for inference (use your physical core count)
# OV_DYNAMIC_QUANT_GROUP_SIZE=32 # OpenVINO dynamic quant (0=off, 32=default, 64=faster/less accurate)
# OV_CACHE_DIR=/ov/cache         # OpenVINO kernel cache (leave default)
# IDLE_UNLOAD_SECONDS=1800       # Unload model after N idle seconds (LOW_RAM_MODE sets 1800)
# OPENVINO_RELEASE_CODEC=1       # Set to 0 if you plan to use VoiceDesign / voice library
# TTS_MAX_SPEECH_SECONDS=64      # Max request length (export-time only; re-export to change)
# TTS_BACKEND=pytorch            # Rollback backend (no IR needed, slower)
# HF_TOKEN=                      # Hugging Face token if checkpoint is gated
# MODEL_REVISION=                # Pin a specific HF revision

# ── VoiceDesign ────────────────────────────────────────────────────────────────
# After Base export, run: docker compose run --rm export-voice-design
# VOICE_DESIGN_MODEL_SIZE=1.7B
# VOICE_DESIGN_MODEL_REPO=
# VOICE_DESIGN_MAX_SPEECH_SECONDS=20
