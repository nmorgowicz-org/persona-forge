# ── Required ──────────────────────────────────────────────────────────────────
REF_AUDIO_PATH=/absolute/path/to/reference.wav
REF_TEXT=Exact transcript of the reference audio
MODEL_SIZE=1.7B

# ── Storage paths ─────────────────────────────────────────────────────────────
# MODEL_CACHE_PATH=./data/model  # Host directory for Hugging Face checkpoint cache
# OV_DATA_PATH=./data/ov         # Host directory for generated OpenVINO IR by model size

# ── Service ───────────────────────────────────────────────────────────────────
# QWEN3_TTS_PORT=8318            # Host port mapped to container port 8318
# TZ=America/Detroit             # Container timezone for log timestamps

# ── Memory limits ─────────────────────────────────────────────────────────────
# TTS_MEMORY_LIMIT=10G           # Serving container cgroup memory limit
# TTS_MEMORY_SWAP_LIMIT=11G      # Serving container cgroup memory+swap limit
# EXPORT_MEMORY_LIMIT=13G        # Export container limit (needs more headroom; stop serving first)
# EXPORT_MEMORY_SWAP_LIMIT=14G

# ── Performance ───────────────────────────────────────────────────────────────
# LOW_RAM_MODE=1                 # Enable jemalloc allocator + aggressive memory return + 30 min idle unload.
#                                # Recommended on hosts with < 20 GiB free RAM.
# OV_INFERENCE_THREADS=6         # CPU threads for OpenVINO transformer + vocoder and PyTorch glue.
#                                # Set to the physical core count of your CPU.
# OV_DYNAMIC_QUANT_GROUP_SIZE=32 # OpenVINO dynamic quantization group size (0 = disabled, 32/64 = on).
#                                # Smaller values trade marginal speed for marginal accuracy.
# OV_CACHE_DIR=/ov/cache         # OpenVINO compiled kernel cache (default: /ov/cache on the OV_DATA_PATH
#                                # mount). Eliminates ~60–120s JIT recompilation on every restart or
#                                # idle-unload reload. Set to empty string to disable.
# IDLE_UNLOAD_SECONDS=1800       # Unload the model after this many idle seconds to free RAM (0 = disabled).
#                                # Reload is automatic on next request but adds ~60–120s of warmup latency.

# ── Audio post-processing ─────────────────────────────────────────────────────
# SILENCE_TRIM=1                 # Trim trailing silence from output audio (1 = on, 0 = off).
#                                # Disable if output seems clipped or you need the raw waveform.
# SILENCE_TRIM_THRESH=0.01       # Amplitude threshold for silence detection (fraction of peak).
# SILENCE_TRIM_PAD_MS=30         # Milliseconds of padding kept after the detected silence boundary.

# ── Backend / model ───────────────────────────────────────────────────────────
# TTS_BACKEND=pytorch            # Set to 'pytorch' for the rollback backend (no IR needed; slower)
# HF_TOKEN=                      # Hugging Face access token; required if the checkpoint is gated
# MODEL_REVISION=                # Pin a specific Hugging Face revision; must match exported IR
# OPENVINO_RELEASE_CODEC=1       # Free the ~0.3 GiB PyTorch codec after startup (default on with
#                                # OpenVINO). Set to 0 to keep it for future per-request cloning.

# ── Max speech length ─────────────────────────────────────────────────────────
# TTS_MAX_SPEECH_SECONDS=64      # Longest single request the exported model can generate, in
#                                # seconds. Baked into the OpenVINO IR at export time — changing
#                                # this requires `docker compose run --rm export` again, and the
#                                # SAME value must be set for both the `export` and `qwen3-tts`
#                                # services (this file applies to both). Lower values do NOT
#                                # meaningfully reduce memory (~0.5 MiB/second of headroom trimmed —
#                                # see docs/dev/benchmarks/OPENVINO_RESULTS.md); use this to fail fast on
#                                # runaway requests instead, not to save RAM. Default 64s if unset.
