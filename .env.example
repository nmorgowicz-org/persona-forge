REF_AUDIO_PATH=/absolute/path/to/reference.wav
REF_TEXT=Exact transcript of the reference audio
MODEL_SIZE=1.7B

# Advanced overrides
# TTS_BACKEND=pytorch
# MODEL_CACHE_PATH=./data/model
# OV_DATA_PATH=./data/ov
# QWEN3_TTS_PORT=8318
# TTS_MEMORY_LIMIT=10G
# TTS_MEMORY_SWAP_LIMIT=11G
# EXPORT_MEMORY_LIMIT=13G       # export needs more headroom than serving; stop serving first
# EXPORT_MEMORY_SWAP_LIMIT=14G
# OPENVINO_RELEASE_CODEC=1      # free the ~0.3 GiB PyTorch codec after startup (default on with
#                              # OpenVINO release-torch). Set 0 for future per-request voice cloning.
# HF_TOKEN=
# MODEL_REVISION=
