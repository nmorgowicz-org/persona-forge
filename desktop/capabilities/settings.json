{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "settings-capability",
  "description": "IPC for the settings window: bundled settings.html only, never the remote server origin.",
  "windows": ["settings"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:default",
    "clipboard-manager:allow-write-text"
  ]
}
