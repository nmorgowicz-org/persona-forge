{
  "name": "persona-forge-ui-e2e",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:ci": "playwright test --reporter=list --workers=1 --retries=2",
    "capture": "node capture/index.mjs",
    "capture:group": "node capture/cli-group.mjs",
    "capture:manifest": "node capture/cli-manifest.mjs --strict",
    "capture:test": "node --test capture/*.test.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "puppeteer": "^25.3.0"
  },
  "allowScripts": {
    "puppeteer@25.3.0": true
  }
}
